# Test-only environment - no secrets. Safe to commit.
NODE_ENV=test
LOG_LEVEL=error

# Testcontainers will provide DB/Redis URLs dynamically
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
TESTCONTAINERS_RYUK_DISABLED=true

# Fallback (if testcontainers unavailable)
DATABASE_URL_TEST_FALLBACK=postgresql://postgres:postgres@localhost:7542/busverse_test
REDIS_URL_TEST_FALLBACK=redis://:redis_dev_password@localhost:7543

# Mocks always on for tests
MOCK_OTP=true
MOCK_EMAIL=true
MOCK_PAYMENT=true
ENABLE_NOTIFICATIONS=false

# Fake secrets for tests
JWT_SECRET=test_jwt_secret_32_bytes_base64_placeholder
PII_ENCRYPTION_KEY=test_pii_key_32_bytes_base64_placeholder
PHONE_HASH_SALT=test_phone_salt_32_bytes_base64_placeholder
# Phase 4 - fixed test Ed25519 keypair
QR_SIGNING_PRIVATE_KEY=gdZ4hh87og4dB5JV1sdWbEroWuYq09EIoBw+2cRU/Kw=
QR_SIGNING_PUBLIC_KEY=+KQUGwPS5MTHyZ28V1+JP0+KG+0g+LgTWfWrQLfFPPw=
# Phase 9 realtime timing — fast tests
WS_AUTH_EXPIRING_LEAD_SEC=1
WS_AUTH_REFRESH_WINDOW_SEC=1
