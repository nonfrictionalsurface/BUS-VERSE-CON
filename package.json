{
    "name":  "busverse-platform",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "pnpm@9.12.0",
    "engines":  {
                    "node":  "22.x"
                },
    "scripts":  {
                    "dev":  "turbo run dev",
                    "build":  "turbo run build",
                    "test":  "turbo run test",
                    "lint":  "turbo run lint",
                    "typecheck":  "turbo run typecheck",
                    "dev:buscon":  "pnpm --filter buscon dev",
                    "dev:driver":  "pnpm --filter driver-app start"
                },
    "devDependencies":  {
                            "@babel/plugin-transform-arrow-functions":  "^8.0.1",
                            "@babel/plugin-transform-shorthand-properties":  "^8.0.1",
                            "@expo/vector-icons":  "^14.0.0",
                            "@react-native/debugger-frontend":  "^0.88.1",
                            "turbo":  "^2.3.0",
                            "typescript":  "^5.4.0"
                        },
    "pnpm":  {
                 "overrides":  {
                                   "tailwindcss":  "3.4.17",
                                   "@tanstack/react-table":  "8.21.2"
                               },
                 "neverBuiltDependencies":  [
                                                "react-native-safe-area-context"
                                            ]
             }
}