generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY (10 tables)
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  phone         String    @db.VarChar(20)
  phoneHash     String    @map("phone_hash") @db.VarChar(64)
  email         String?   @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  name          String?   @db.VarChar(100)
  isTest        Boolean   @default(false) @map("is_test")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  version       Int       @default(0)

  passengerProfile    PassengerProfile?
  operatorUsers       OperatorUser[]
  driverProfile       DriverProfile?
  adminUser           AdminUser?
  sessions            Session[]
  otpChallenges       OtpChallenge[]
  consentRecords      ConsentRecord[]
  passwordResetTokens PasswordResetToken[]
  seatLocks           SeatLock[]
  bookings            Booking[]

  @@index([phone])
  @@index([phoneHash])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model PassengerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  name            String   @db.VarChar(100)
  dob             DateTime? @db.Date
  gender          String?  @db.VarChar(10)
  preferencesJson Json     @default("{\"_v\":1}") @map("preferences_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         Int      @default(0)
  isTest          Boolean  @default(false) @map("is_test")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passenger_profiles")
}

model OperatorUser {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  operatorId   String    @map("operator_id") @db.Uuid
  role         String    @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  invitedBy    String?   @map("invited_by") @db.Uuid
  invitedAt    DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([operatorId])
  @@map("operator_users")
}

model DriverProfile {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  operatorId    String    @map("operator_id") @db.Uuid
  licenseNumber String    @map("license_number") @db.VarChar(20)
  kycStatus     String    @default("INVITED") @map("kyc_status") @db.VarChar(20)
  onDuty        Boolean   @default(false) @map("on_duty")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz
  kycDocumentsJson    Json?     @map("kyc_documents_json") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  version       Int       @default(0)
  isTest        Boolean   @default(false) @map("is_test")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  trips    Trip[]
  scans    BoardingScan[]

  @@index([operatorId])
  @@index([onDuty])
  @@map("driver_profiles")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  role         String    @default("SUPER_ADMIN") @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_users")
}

model Session {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  role                  String    @db.VarChar(30)
  deviceFingerprintHash String?   @map("device_fingerprint_hash") @db.VarChar(64)
  refreshHash           String    @map("refresh_hash") @db.VarChar(64)
  status                String    @default("ACTIVE") @db.VarChar(20)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason          String?   @map("revoke_reason") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  version               Int       @default(0)
  isTest                Boolean   @default(false) @map("is_test")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain  RefreshTokenChain?

  @@index([userId])
  @@index([refreshHash])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  phoneOrEmail String    @map("phone_or_email") @db.VarChar(255)
  otpHash      String    @map("otp_hash") @db.VarChar(64)
  otpSalt      String    @map("otp_salt") @db.VarChar(32)
  purpose       String    @default("LOGIN")
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneOrEmail, purpose, expiresAt])
  @@map("otp_challenges")
}

model RefreshTokenChain {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @unique @map("session_id") @db.Uuid
  usedHashes Json      @default("[]") @map("used_hashes") @db.JsonB
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  version    Int       @default(0)
  isTest     Boolean   @default(false) @map("is_test")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_token_chains")
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String    @db.VarChar(50)
  policyVersion String    @map("policy_version") @db.VarChar(20)
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  version       Int       @default(0)
  isTest        Boolean   @default(false) @map("is_test")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_records")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)
  isTest    Boolean   @default(false) @map("is_test")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// NETWORK (9 tables)
// ============================================================

model City {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  state     String    @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  stands        Stand[]
  originRoutes  Route[] @relation("RouteOrigin")
  destRoutes    Route[] @relation("RouteDestination")

  @@map("cities")
}

model Stand {
  id        String    @id @default(uuid()) @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  name      String    @db.VarChar(150)
  type      String    @default("BUS_STAND") @db.VarChar(20)
  lat       Decimal   @db.Decimal(9, 6)
  lng       Decimal   @db.Decimal(9, 6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  city           City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  routeStands    RouteStand[]
  boardingBookings  Booking[]  @relation("BoardingStand")
  droppingBookings  Booking[]  @relation("DroppingStand")
  scans          BoardingScan[]

  @@index([cityId])
  @@map("stands")
}

model Operator {
  id             String    @id @default(uuid()) @db.Uuid
  companyName    String    @map("company_name") @db.VarChar(200)
  gstin          String    @db.VarChar(15)
  pan            String    @db.VarChar(10)
  bankAccountRef String?   @map("bank_account_ref") @db.VarChar(100)
  status         String    @default("APPLIED") @db.VarChar(30)
  isTest         Boolean   @default(false) @map("is_test")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  operatorUsers  OperatorUser[]
  driverProfiles DriverProfile[]
  buses          Bus[]
  routes         Route[]
  schedules      Schedule[]

  @@index([gstin])
  @@map("operators")
}

model Bus {
  id                  String    @id @default(uuid()) @db.Uuid
  operatorId          String    @map("operator_id") @db.Uuid
  registrationNumber  String    @map("registration_number") @db.VarChar(20)
  model               String?   @db.VarChar(100)
  capacity            Int
  busType             String    @map("bus_type") @db.VarChar(20)
  amenitiesJson       Json      @default("{\"_v\":1,\"items\":[]}") @map("amenities_json") @db.JsonB
  approvalStatus      String    @default("PENDING") @map("approval_status") @db.VarChar(20)
  insuranceDocRef     String?   @map("insurance_doc_ref") @db.VarChar(200)
  insuranceExpiresAt  DateTime? @map("insurance_expires_at") @db.Date
  isTest              Boolean   @default(false) @map("is_test")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  version             Int       @default(0)

  operator   Operator    @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  layout     SeatLayout?
  schedules  Schedule[]
  trips      Trip[]

  @@index([operatorId])
  @@map("buses")
}

model SeatLayout {
  id           String    @id @default(uuid()) @db.Uuid
  busId        String    @unique @map("bus_id") @db.Uuid
  rowsCount    Int       @map("rows_count")
  columnsCount Int       @map("columns_count")
  aisleMapJson Json      @default("{\"_v\":1,\"aisle_cells\":[]}") @map("aisle_map_json") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  bus   Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@map("seat_layouts")
}

model Seat {
  id           String    @id @default(uuid()) @db.Uuid
  layoutId     String    @map("layout_id") @db.Uuid
  seatRow      String    @map("seat_row") @db.VarChar(3)
  seatColumn   Int       @map("seat_column")
  seatLabel    String    @map("seat_label") @db.VarChar(4)
  seatType     String    @default("SEATER") @map("seat_type") @db.VarChar(20)
  isFemaleOnly Boolean   @default(false) @map("is_female_only")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  layout        SeatLayout         @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatLocks     SeatLock[]
  bookingSeats  BookingPassenger[]

  @@index([layoutId])
  @@map("seats")
}

model Route {
  id                 String    @id @default(uuid()) @db.Uuid
  operatorId         String    @map("operator_id") @db.Uuid
  originCityId       String    @map("origin_city_id") @db.Uuid
  destinationCityId  String    @map("destination_city_id") @db.Uuid
  approvalStatus     String    @default("PENDING") @map("approval_status") @db.VarChar(20)
  isTest             Boolean   @default(false) @map("is_test")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            Int       @default(0)

  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  originCity  City         @relation("RouteOrigin", fields: [originCityId], references: [id], onDelete: Restrict)
  destCity    City         @relation("RouteDestination", fields: [destinationCityId], references: [id], onDelete: Restrict)
  stands      RouteStand[]
  schedules   Schedule[]

  @@index([operatorId])
  @@index([originCityId, destinationCityId])
  @@map("routes")
}

model RouteStand {
  id                 String    @id @default(uuid()) @db.Uuid
  routeId            String    @map("route_id") @db.Uuid
  standId            String    @map("stand_id") @db.Uuid
  sequence           Int
  distanceFromPrevKm Decimal   @default(0) @map("distance_from_prev_km") @db.Decimal(7, 2)
  durationFromPrevMin Int      @default(0) @map("duration_from_prev_min")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            Int       @default(0)
  isTest             Boolean   @default(false) @map("is_test")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stand Stand @relation(fields: [standId], references: [id], onDelete: Restrict)

  @@index([routeId])
  @@map("route_stands")
}

model Schedule {
  id              String    @id @default(uuid()) @db.Uuid
  operatorId      String    @map("operator_id") @db.Uuid
  busId           String    @map("bus_id") @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  departureTime   DateTime  @map("departure_time") @db.Timestamptz
  arrivalTime     DateTime  @map("arrival_time") @db.Timestamptz
  fareAmountPaise BigInt    @map("fare_amount_paise") @db.BigInt
  fareCurrency    String    @default("INR") @map("fare_currency") @db.VarChar(3)
  status          String    @default("DRAFT") @db.VarChar(20)
  isTest          Boolean   @default(false) @map("is_test")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         Int       @default(0)

  operator   Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  bus        Bus          @relation(fields: [busId], references: [id], onDelete: Restrict)
  route      Route        @relation(fields: [routeId], references: [id], onDelete: Restrict)
  seatLocks  SeatLock[]
  bookings   Booking[]
  trips      Trip[]
  passes     BookingPassenger[]

  @@index([operatorId])
  @@index([busId])
  @@index([routeId, departureTime, status])
  @@map("schedules")
}

// ============================================================
// BOOKING (4 tables)
// ============================================================

model SeatLock {
  id         String    @id @default(uuid()) @db.Uuid
  scheduleId String    @map("schedule_id") @db.Uuid
  seatId     String    @map("seat_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  acquiredAt DateTime  @default(now()) @map("acquired_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  version    Int       @default(0)
  isTest     Boolean   @default(false) @map("is_test")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("seat_locks")
}

model Booking {
  id                  String    @id @default(uuid()) @db.Uuid
  bookingReference    String    @map("booking_reference") @db.VarChar(20)
  userId              String    @map("user_id") @db.Uuid
  scheduleId          String    @map("schedule_id") @db.Uuid
  boardingStandId     String    @map("boarding_stand_id") @db.Uuid
  droppingStandId     String    @map("dropping_stand_id") @db.Uuid
  totalFareAmount     BigInt    @map("total_fare_amount") @db.BigInt
  totalFareCurrency   String    @default("INR") @map("total_fare_currency") @db.VarChar(3)
  fareBreakdownJson   Json      @default("{\"_v\":1}") @map("fare_breakdown_json") @db.JsonB
  status              String    @default("PENDING") @db.VarChar(30)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz
  checkedInAt         DateTime? @map("checked_in_at") @db.Timestamptz
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz
  expiredAt           DateTime? @map("expired_at") @db.Timestamptz
  isTest              Boolean   @default(false) @map("is_test")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  version             Int       @default(0)

  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedule       Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  boardingStand  Stand              @relation("BoardingStand", fields: [boardingStandId], references: [id], onDelete: Restrict)
  droppingStand  Stand              @relation("DroppingStand", fields: [droppingStandId], references: [id], onDelete: Restrict)
  passengers     BookingPassenger[]
  ticket         Ticket?
  payments       Payment[]
  gstInvoice     GstInvoice?

  @@index([userId, status, createdAt])
  @@index([scheduleId])
  @@map("bookings")
}

model BookingPassenger {
  id         String    @id @default(uuid()) @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  seatId     String    @map("seat_id") @db.Uuid
  scheduleId String    @map("schedule_id") @db.Uuid
  name       String    @db.VarChar(100)
  age        Int?
  gender     String?   @db.VarChar(10)
  idNumber   String?   @map("id_number") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  version    Int       @default(0)
  isTest     Boolean   @default(false) @map("is_test")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_passengers")
}

model Ticket {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String    @unique @map("booking_id") @db.Uuid
  qrPayload    String    @map("qr_payload") @db.Text
  qrSignature  String    @map("qr_signature") @db.VarChar(128)
  status       String    @default("ISSUED") @db.VarChar(20)
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  scannedAt    DateTime? @map("scanned_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)
  isTest       Boolean   @default(false) @map("is_test")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scans   BoardingScan[]

  @@index([status])
  @@map("tickets")
}

// ============================================================
// PAYMENTS (4 tables)
// ============================================================

model Payment {
  id                 String    @id @default(uuid()) @db.Uuid
  bookingId          String    @map("booking_id") @db.Uuid
  idempotencyKey     String    @map("idempotency_key") @db.VarChar(100)
  gateway            String    @default("RAZORPAY") @db.VarChar(20)
  method             String?   @db.VarChar(20)
  methodDetailsJson  Json?     @map("method_details_json") @db.JsonB
  amountPaise        BigInt    @map("amount_paise") @db.BigInt
  currency           String    @default("INR") @db.VarChar(3)
  status             String    @default("INITIATED") @db.VarChar(20)
  gatewayOrderId     String?   @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId   String?   @map("gateway_payment_id") @db.VarChar(100)
  initiatedAt        DateTime  @default(now()) @map("initiated_at") @db.Timestamptz
  succeededAt        DateTime? @map("succeeded_at") @db.Timestamptz
  failedAt           DateTime? @map("failed_at") @db.Timestamptz
  expiredAt          DateTime? @map("expired_at") @db.Timestamptz
  isTest             Boolean   @default(false) @map("is_test")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            Int       @default(0)

  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds        Refund[]
  webhooks       GatewayWebhook[]

  @@index([bookingId])
  @@index([status])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model Refund {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  reason          String    @db.VarChar(50)
  refundTier      String    @map("refund_tier") @db.VarChar(20)
  amountPaise     BigInt    @map("amount_paise") @db.BigInt
  status          String    @default("INITIATED") @db.VarChar(20)
  gatewayRefundId String?   @map("gateway_refund_id") @db.VarChar(100)
  initiatedAt     DateTime  @default(now()) @map("initiated_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  failureReason   String?   @map("failure_reason") @db.VarChar(200)
  isTest          Boolean   @default(false) @map("is_test")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         Int       @default(0)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model GstInvoice {
  id                 String    @id @default(uuid()) @db.Uuid
  bookingId          String    @unique @map("booking_id") @db.Uuid
  invoiceNumber      String    @unique @map("invoice_number") @db.VarChar(30)
  gstin              String    @db.VarChar(15)
  taxableValuePaise  BigInt    @map("taxable_value_paise") @db.BigInt
  gstAmountPaise     BigInt    @map("gst_amount_paise") @db.BigInt
  issuedAt           DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  isTest             Boolean   @default(false) @map("is_test")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            Int       @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("gst_invoices")
}

model GatewayWebhook {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(50)
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  payloadJson Json     @map("payload_json") @db.JsonB
  signature   String   @db.VarChar(200)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz
  isTest      Boolean  @default(false) @map("is_test")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([receivedAt])
  @@map("gateway_webhooks")
}

// ============================================================
// TRIP (3 tables)
// ============================================================

model Trip {
  id           String    @id @default(uuid()) @db.Uuid
  scheduleId   String    @map("schedule_id") @db.Uuid
  busId        String    @map("bus_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  status       String    @default("SCHEDULED") @db.VarChar(20)
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  endedAt      DateTime? @map("ended_at") @db.Timestamptz
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz
  delayReason  String?   @map("delay_reason") @db.VarChar(50)
  delayMinutes Int?      @map("delay_minutes")
  distanceKm   Decimal?  @map("distance_km") @db.Decimal(8, 2)
  isTest       Boolean   @default(false) @map("is_test")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  version      Int       @default(0)

  schedule Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  bus      Bus            @relation(fields: [busId], references: [id], onDelete: Restrict)
  driver   DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  gps      GpsSample[]
  scans    BoardingScan[]

  @@index([scheduleId])
  @@index([driverId, status])
  @@map("trips")
}

model GpsSample {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  speedKmh    Decimal? @map("speed_kmh") @db.Decimal(5, 2)
  accuracyM   Decimal? @map("accuracy_m") @db.Decimal(5, 2)
  clientReportedSpeedKmh Decimal? @map("client_reported_speed_kmh") @db.Decimal(5, 2)
  receivedAt  DateTime @map("received_at") @db.Timestamptz
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("gps_samples")
}

model BoardingScan {
  id         String    @id @default(uuid()) @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  driverId   String    @map("driver_id") @db.Uuid
  standId    String    @map("stand_id") @db.Uuid
  result     String    @db.VarChar(30)
  scannedAt  DateTime  @default(now()) @map("scanned_at") @db.Timestamptz
  scannedLat Decimal?  @map("scanned_lat") @db.Decimal(9, 6)
  scannedLng Decimal?  @map("scanned_lng") @db.Decimal(9, 6)
  isTest     Boolean   @default(false) @map("is_test")

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)
  stand  Stand  @relation(fields: [standId], references: [id], onDelete: Restrict)

  @@unique([ticketId, tripId], map: "uniq_boarding_scans_ticket_trip")
  @@index([tripId])
  @@index([ticketId])
  @@index([scannedAt])
  @@map("boarding_scans")
}

// ============================================================
// AUDIT (1 table)
// ============================================================

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String   @map("entity_id") @db.Uuid
  action       String   @db.VarChar(50)
  reason       String?  @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  metadataJson Json     @default("{\"_v\":1}") @map("metadata_json") @db.JsonB
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}