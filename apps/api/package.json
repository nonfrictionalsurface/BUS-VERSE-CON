{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/bootstrap.ts",
        "build": "tsc",
        "start": "node dist/bootstrap.js",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "lint": "echo \"(lint pending eslint setup)\"",
        "typecheck": "tsc --noEmit",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:constraints": "prisma db execute --file prisma/constraints.sql",
        "db:migrate": "prisma migrate dev --name init",
        "db:constraints": "prisma db execute --file prisma/constraints.sql",
        "db:reset": "prisma migrate reset --force --skip-seed && pnpm db:constraints && pnpm db:seed",
        "db:seed": "tsx prisma/seed.ts",
        "db:seed:assert": "tsx scripts/seed-assert.ts",
        "db:verify": "tsx scripts/db-verify.ts"
    },
    "dependencies": {
        "@busverse/seat-engine": "workspace:*",
        "@aws-sdk/client-s3": "^3.1159.0",
        "@aws-sdk/s3-request-presigner": "^3.1159.0",
        "@fastify/cors": "^11.3.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.9.2",
        "@fastify/swagger-ui": "^6.1.2",
        "@noble/ed25519": "3.2.0",
        "@noble/hashes": "^1.4.0",
        "@node-rs/argon2": "^2.2.2",
        "@prisma/client": "^5.22.0",
        "bullmq": "^5.34.0",
        "dotenv": "^16.4.5",
        "fastify": "^5.1.0",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.13.0",
        "pino": "^9.5.0",
        "pino-pretty": "^13.0.0",
        "razorpay": "^2.9.4",
        "socket.io": "^4.8.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.9.0",
        "@types/pg": "^8.11.10",
        "@vitest/coverage-v8": "2.1.9",
        "prisma": "^5.22.0",
        "socket.io-client": "^4.8.1",
        "tsx": "^4.19.2",
        "typescript": "^5.4.0",
        "vitest": "^2.1.4"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
