# =============================================================================
# BusVerse + BusCon - Environment Variables Template
# Copy this file to .env and fill in real values.
# Save as UTF-8 (not UTF-16).
# =============================================================================

# ----- Core -----
NODE_ENV=development
PORT=4310
LOG_LEVEL=info

# ----- Database (note: port 5433 to avoid local Postgres conflict) -----
DATABASE_URL=postgresql://postgres:postgres@localhost:7542/busverse

# ----- Redis -----
REDIS_URL=redis://:redis_dev_password@localhost:7543

# ----- Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") -----
JWT_SECRET=FIqeA2e64oRejJeSw6xL9VazsRCrvZ+72npadyUkR08=
PII_ENCRYPTION_KEY=vL3i1aLAkw2wgzzpEj6HD77c9Qf3tzsmwBvhy9oO6es=
PHONE_HASH_SALT=gMrpAAseyXxP/mv3SZK+KCNuat6RL99UCv/o3toOKdg=

# ----- QR signing (generate in Phase 4 with @noble/ed25519) -----
QR_SIGNING_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_BASE64
QR_SIGNING_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_BASE64

# ----- Razorpay (test mode) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=REPLACE_WITH_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ----- MSG91 (SMS delivery) -----
MSG91_AUTH_KEY=REPLACE_WITH_KEY
MSG91_SENDER_ID=BUSVER

# ----- SendGrid (email delivery) -----
SENDGRID_API_KEY=REPLACE_WITH_KEY

# ----- Cloudflare R2 (file storage) -----
R2_ACCESS_KEY_ID=REPLACE_WITH_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
R2_BUCKET=busverse-uploads-dev
R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://10.95.63.179:8081,http://10.95.63.179:8082,http://localhost:3410,http://localhost:3411,http://localhost:3000,http://localhost:3001,http://localhost:19006

# ----- Admin break-glass recovery -----
ADMIN_EMAIL=admin@busverse.app
ADMIN_RECOVERY_TOKEN=jJ+7Qv6lnFSHBvBc+0Fo2LMx49rwKMg6hW6+PdiGtXjkSKSWjMBcuuPLadiGJf4a

# ----- Webhook fallback -----
TMP_WEBHOOKS_DIR=/tmp/webhooks

# ----- Demo mode (set true during viva for extended payment window) -----
DEMO_MULTI_DEVICE_DRIVER=false

# ----- Dev-only mocks (set true for local dev) -----
MOCK_OTP=true
MOCK_EMAIL=true
MOCK_PAYMENT=false
ENABLE_NOTIFICATIONS=false

# ----- Observability (Phase 12) -----
SENTRY_DSN=
RAILWAY_ENVIRONMENT=