# =============================================================================
# BusVerse + BusCon API - PRODUCTION env template
#
# Copy this to .env.production and fill every REPLACE_* value.
# .env.production is gitignored (Block 1) - never commit it.
#
# Used by: docker-compose.prod.yml (env_file: .env.production)
# =============================================================================

# ----- Compose-level (required by compose ${VAR:?} guards) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=busverse
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ----- Runtime -----
NODE_ENV=production
PORT=4310
LOG_LEVEL=info

# ----- Core DB / Redis -----
# Overridden by compose "environment:" block (service names postgres/redis).
# Kept here so the app can start outside compose for debugging.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/busverse
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379

# ----- Auth secrets (32 bytes base64) -----
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_32_BYTES_BASE64
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
PHONE_HASH_SALT=REPLACE_WITH_32_BYTES_BASE64

# ----- QR signing (32-byte seed + 32-byte pubkey, base64) -----
# Generate with the node crypto snippet in key-recovery.md §4
QR_SIGNING_PRIVATE_KEY=REPLACE_WITH_ED25519_SEED_BASE64
QR_SIGNING_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBKEY_BASE64

# ----- Razorpay (test mode for viva) -----
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_WITH_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ----- MSG91 (SMS - mock in viva) -----
MSG91_AUTH_KEY=REPLACE_WITH_KEY
MSG91_SENDER_ID=BUSVER

# ----- SendGrid (email - mock in viva) -----
SENDGRID_API_KEY=REPLACE_WITH_KEY

# ----- Cloudflare R2 (Phase 12 real adapter) -----
R2_ACCESS_KEY_ID=REPLACE_WITH_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
R2_BUCKET=busverse-uploads-dev
R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com

# ----- CORS - matches .env.example defaults; update when frontends deploy -----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ----- Admin break-glass -----
ADMIN_EMAIL=admin@busverse.app
ADMIN_RECOVERY_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING

# ----- Webhook fallback temp dir -----
TMP_WEBHOOKS_DIR=/tmp/webhooks

# ----- Demo mode -----
DEMO_MULTI_DEVICE_DRIVER=false

# ----- Mock toggles (copy values from .env.example) -----
MOCK_OTP=true
MOCK_EMAIL=true
MOCK_PAYMENT=false
ENABLE_NOTIFICATIONS=false

# ----- Observability (Phase 12 - optional) -----
SENTRY_DSN=
RAILWAY_ENVIRONMENT=